<div class="llmify-status">
  <div class="llmify-status-line">
    <span>
      {% if not cached %}
        Not cached
      {% elseif cached.value is empty %}
        Cached · empty
      {% else %}
        Cached · ~{{ tokens|number }} tokens
      {% endif %}
    </span>
    <a href="{{ markdownUrl }}" target="_blank" rel="noopener" title="View markdown" aria-label="View markdown">↗</a>
  </div>
  {% if cached %}
    <div class="light smalltext">{{ cached.dateCached|datetime('short') }}</div>
  {% endif %}
  {% if cached and cached.value is empty %}
    <div class="warning smalltext">
      Check your <a href="https://samuelreichor.at/libraries/craft-llmify/usage/content-control" target="_blank" rel="noopener">template setup</a>.
    </div>
  {% endif %}
  {% if canGenerate or (canClear and cached) %}
    <div class="llmify-actions smalltext">
      {% if canGenerate %}
        <a role="button" href="#" data-llmify-action="{{ generateActionUrl }}">Refresh</a>
      {% endif %}
      {% if canGenerate and canClear and cached %}
        <span class="light">·</span>
      {% endif %}
      {% if canClear and cached %}
        <a role="button" href="#" data-llmify-action="{{ clearActionUrl }}">Clear</a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% css %}
  .llmify-sidebar .llmify-status {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: var(--s);
  }

  .llmify-sidebar .llmify-status-line {
    display: flex;
    justify-content: space-between;
    gap: var(--s);
  }

  .llmify-sidebar .llmify-actions {
    display: flex;
    gap: 6px;
    margin-top: 4px;
  }

  .llmify-sidebar .llmify-actions a.disabled {
    opacity: 0.5;
    pointer-events: none;
  }
{% endcss %}

{% js %}
  if (!window.llmifySidebarBound) {
    window.llmifySidebarBound = true;

    // Delegated, since the sidebar is replaced after every action.
    document.addEventListener('click', (e) => {
      const link = e.target.closest('.llmify-sidebar [data-llmify-action]');
      if (!link) {
        return;
      }

      e.preventDefault();
      link.classList.add('disabled');

      Craft.sendActionRequest('POST', link.dataset.llmifyAction)
        .then((response) => {
          Craft.cp.displaySuccess(response.data.message);
          const sidebar = link.closest('.llmify-sidebar');
          sidebar.insertAdjacentHTML('beforebegin', response.data.html);
          sidebar.remove();
        })
        .catch(({response}) => {
          link.classList.remove('disabled');
          Craft.cp.displayError(response?.data?.message);
        });
    });
  }
{% endjs %}
