{% import '_includes/forms' as forms %}

<div class="data">
  <div class="heading">Status</div>
  <div class="value">
    {% if cached %}
      <a href="{{ markdownUrl }}" target="_blank" rel="noopener">Cached</a>
    {% else %}
      Not cached
    {% endif %}
  </div>
</div>
{% if cached %}
  <div class="data">
    <div class="heading">Cached At</div>
    <div class="value">{{ cached.dateCached|datetime('short') }}</div>
  </div>
  {% if cached.value is empty %}
    <div class="data">
      <div class="heading"></div>
      <div class="value">
        <p class="warning with-icon" style="margin: 0;">
          Markdown empty. Check your <a href="https://samuelreichor.at/libraries/craft-llmify/usage/content-control" target="_blank" rel="noopener">template setup</a> for more information.
        </p>
      </div>
    </div>
  {% else %}
    <div class="data">
      <div class="heading">Size</div>
      <div class="value">~{{ tokens|number }} tokens</div>
    </div>
  {% endif %}
{% else %}
  <div class="data">
    <div class="heading">Markdown</div>
    <div class="value">
      <a href="{{ markdownUrl }}" target="_blank" rel="noopener">View</a>
    </div>
  </div>
{% endif %}
{% if canGenerate or (canClear and cached) %}
  <div class="llmify-btn-group flex fullwidth">
    {% if canGenerate %}
      {{ forms.button({
        label: 'Refresh',
        spinner: true,
        attributes: {
          data: {'llmify-action': generateActionUrl},
        },
      }) }}
    {% endif %}
    {% if canClear and cached %}
      {{ forms.button({
        label: 'Clear',
        spinner: true,
        attributes: {
          data: {'llmify-action': clearActionUrl},
        },
      }) }}
    {% endif %}
  </div>
{% endif %}

{% css %}
  .llmify-sidebar .meta .data {
  min-height: 0;
  }

  .llmify-sidebar .meta .data:first-of-type {
  padding-top: 8px;
  }

  .llmify-sidebar .meta .data:last-of-type {
  padding-bottom: 8px;
  }

  .llmify-sidebar .llmify-btn-group {
    padding-block: var(--s);
  }
{% endcss %}

{% js %}
  if (!window.llmifySidebarBound) {
    window.llmifySidebarBound = true;

    // Delegated, since the sidebar is replaced after every action.
    document.addEventListener('click', (e) => {
      const button = e.target.closest('.llmify-sidebar [data-llmify-action]');
      if (!button) {
        return;
      }

      e.preventDefault();
      button.classList.add('loading');

      Craft.sendActionRequest('POST', button.dataset.llmifyAction)
        .then((response) => {
          Craft.cp.displaySuccess(response.data.message);
          const sidebar = button.closest('.llmify-sidebar');
          sidebar.insertAdjacentHTML('beforebegin', response.data.html);
          sidebar.remove();
        })
        .catch(({response}) => {
          button.classList.remove('loading');
          Craft.cp.displayError(response?.data?.message);
        });
    });
  }
{% endjs %}
