{% import "_includes/forms" as forms %}
<h2>llms-full.txt</h2>
<p>Generated by <code>php craft llmify/llms-full/generate</code>. Run it on a schedule (e.g. a cron job) to keep the file up to date.</p>
{% set cols = {
  heading: {
    type: 'heading',
    heading: "Site",
  },
  status: {
    type: 'html',
    heading: "Last Generated",
  },
} %}

{% set rows = [] %}
{% for site in llmsFullTable %}
  {% set rows = rows|merge([{
    heading: site.name,
    status: not site.enabled ? 'Disabled' : (site.dateGenerated ? site.dateGenerated|datetime('short') : 'Never'),
  }]) %}
{% endfor %}

{{ forms.editableTableField({
  name: 'llmsFull',
  id: 'llmsFull',
  cols: cols,
  rows: rows,
  staticRows: true,
}) }}

{% if not isEnabled %}
  <p>Markdown Creation is disabled. If you want to see the actions you need to enable it in the plugin settings.</p>
{% elseif canClear %}
  <h2>Actions</h2>

  <form class="utility" method="post" accept-charset="UTF-8">
    {{ actionInput('llmify/markdown/clear-caches') }}
    {{ redirectInput('utilities/llmify') }}
    {{ csrfInput() }}
    <p>Markdown pages and llms.txt are cached and invalidated automatically when content changes. Clear the caches after changing templates.</p>
    <button type="submit" class="btn submit">Clear Markdown Caches</button>
  </form>
{% endif %}
