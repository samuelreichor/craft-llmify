{% import "_includes/forms" as forms %}
<h2>Markdown Cache</h2>
{% set cols = {
  heading: {
    type: 'heading',
    heading: "Site",
  },
  cached: {
    type: 'html',
    heading: "Cached Pages",
  },
  oldest: {
    type: 'html',
    heading: "Oldest Cache",
  },
} %}

{% set rows = [] %}
{% for site in siteTable %}
  {% set rows = rows|merge([{
    heading: site.name,
    cached: site.cacheStats.cached|number ~ ' / ' ~ site.cacheStats.total|number,
    oldest: site.cacheStats.oldestCached ? site.cacheStats.oldestCached|datetime('short') : '-',
  }]) %}
{% endfor %}

{{ forms.editableTableField({
  name: 'markdownCaches',
  id: 'markdownCaches',
  cols: cols,
  rows: rows,
  staticRows: true,
}) }}

{% if not isEnabled %}
  <p>Markdown Creation is disabled. If you want to see the actions you need to enable it in the plugin settings.</p>
{% elseif canGenerate or canClear %}
  <h2>Actions</h2>

  {% if canGenerate %}
  <form class="utility" method="post" accept-charset="UTF-8">
    {{ actionInput('llmify/markdown/generate') }}
    {{ redirectInput('utilities/llmify') }}
    {{ csrfInput() }}
    <p>Cache all pages that are not cached yet.</p>
    <button type="submit" class="btn submit">Warm Cache</button>
  </form>
  {% endif %}

  {% if canClear %}
  <form class="utility" method="post" accept-charset="UTF-8">
    {{ actionInput('llmify/markdown/clear') }}
    {{ redirectInput('utilities/llmify') }}
    {{ csrfInput() }}
    <p>Clear the markdown cache of all pages.</p>
    <button type="submit" class="btn submit">Clear Cache</button>
  </form>
  {% endif %}
{% endif %}
